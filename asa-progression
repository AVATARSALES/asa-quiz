<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ASA — Ma Progression</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
  *{margin:0;padding:0;box-sizing:border-box}
  :root{
    --navy:#0D1B35;--navy-light:#1A2D4F;--gold:#D4A843;--gold-light:#F5E6C0;
    --bg:#F0F2F5;--card:#FFFFFF;--text:#1A1A2E;--muted:#8B92A5;
    --green:#10B981;--green-bg:#D1FAE5;--orange:#F59E0B;--orange-bg:#FEF3C7;
    --red:#EF4444;--red-bg:#FEE2E2;--blue:#6366F1;
    --radius:16px;--shadow:0 2px 12px rgba(13,27,53,0.08);
  }
  body{font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:var(--text);min-height:100vh}

  /* Header */
  .header{
    background:linear-gradient(135deg,var(--navy) 0%,var(--navy-light) 100%);
    padding:24px;display:flex;align-items:center;gap:14px;
    border-bottom:3px solid var(--gold);
  }
  .header .logo{
    width:40px;height:40px;background:var(--gold);border-radius:10px;
    display:flex;align-items:center;justify-content:center;
    font-weight:800;font-size:20px;color:var(--navy);
    box-shadow:0 2px 8px rgba(212,168,67,0.4);
  }
  .header h1{color:#fff;font-size:15px;font-weight:600;line-height:1.3}
  .header h1 span{color:var(--gold);display:block;font-size:18px;font-weight:800}

  .container{max-width:540px;margin:0 auto;padding:20px 16px 40px}

  /* Selector */
  .selector{
    background:var(--card);border-radius:var(--radius);padding:16px;
    box-shadow:var(--shadow);margin-bottom:16px;
    display:flex;align-items:center;gap:12px;
  }
  .selector .avatar{
    width:44px;height:44px;border-radius:12px;
    background:linear-gradient(135deg,var(--navy),var(--blue));
    display:flex;align-items:center;justify-content:center;
    font-size:18px;font-weight:700;color:#fff;flex-shrink:0;
  }
  .selector select{
    flex:1;padding:8px 12px;border:2px solid #E5E7EB;border-radius:10px;
    font-family:inherit;font-size:15px;font-weight:600;color:var(--navy);
    background:var(--bg);cursor:pointer;transition:all 0.2s;
  }
  .selector select:focus{outline:none;border-color:var(--gold);background:#fff}

  /* Score ring */
  .score-hero{
    background:var(--card);border-radius:var(--radius);
    padding:28px 20px;box-shadow:var(--shadow);margin-bottom:16px;
    display:flex;align-items:center;gap:24px;
  }
  .ring-container{position:relative;width:110px;height:110px;flex-shrink:0}
  .ring-bg,.ring-fill{
    fill:none;stroke-width:10;transform:rotate(-90deg);transform-origin:center;
  }
  .ring-bg{stroke:#E5E7EB}
  .ring-fill{stroke:var(--gold);stroke-linecap:round;transition:stroke-dashoffset 1s ease,stroke 0.5s}
  .ring-label{
    position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;
  }
  .ring-label .pct{font-size:28px;font-weight:800;color:var(--navy);line-height:1}
  .ring-label .tag{font-size:10px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em;margin-top:2px}
  .score-details{flex:1}
  .score-details .level-badge{
    display:inline-block;padding:6px 14px;border-radius:20px;
    font-size:13px;font-weight:700;margin-bottom:10px;
  }
  .level-badge.green{background:var(--green-bg);color:#065F46}
  .level-badge.yellow{background:var(--orange-bg);color:#92400E}
  .level-badge.orange{background:#FFEDD5;color:#9A3412}
  .level-badge.red{background:var(--red-bg);color:#991B1B}
  .score-details .meta{font-size:13px;color:var(--muted);line-height:1.6}
  .score-details .meta strong{color:var(--text);font-weight:600}

  /* Stat row */
  .stats{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:16px}
  .stat{
    background:var(--card);border-radius:12px;padding:16px 12px;
    box-shadow:var(--shadow);text-align:center;
  }
  .stat .num{font-size:24px;font-weight:800;color:var(--navy);line-height:1}
  .stat .lbl{font-size:10px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;margin-top:6px}
  .stat .delta{font-size:12px;font-weight:700;margin-top:4px}
  .delta.up{color:var(--green)}
  .delta.down{color:var(--red)}
  .delta.flat{color:var(--muted)}

  /* Chart */
  .chart-card{
    background:var(--card);border-radius:var(--radius);
    padding:20px;box-shadow:var(--shadow);margin-bottom:16px;
  }
  .chart-card .title{
    font-size:13px;font-weight:600;color:var(--muted);
    text-transform:uppercase;letter-spacing:0.06em;margin-bottom:14px;
  }
  .chart-card canvas{width:100%!important;height:180px!important}

  /* Activity */
  .activity-card{
    background:var(--card);border-radius:var(--radius);
    box-shadow:var(--shadow);overflow:hidden;
  }
  .activity-card .title{
    font-size:13px;font-weight:600;color:var(--muted);
    text-transform:uppercase;letter-spacing:0.06em;
    padding:16px 16px 12px;
  }
  .act-row{
    display:flex;align-items:center;padding:10px 16px;gap:12px;
    border-top:1px solid #F3F4F6;transition:background 0.15s;
  }
  .act-row:hover{background:#FAFBFC}
  .act-icon{
    width:36px;height:36px;border-radius:10px;
    background:linear-gradient(135deg,var(--gold-light),#FFF8E7);
    display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;
  }
  .act-info{flex:1;min-width:0}
  .act-info .name{font-size:13px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .act-info .date{font-size:11px;color:var(--muted)}
  .act-score{
    font-size:14px;font-weight:700;padding:5px 12px;border-radius:10px;white-space:nowrap;
  }
  .act-score.high{background:var(--green-bg);color:#065F46}
  .act-score.mid{background:var(--orange-bg);color:#92400E}
  .act-score.low{background:var(--red-bg);color:#991B1B}

  .loading{text-align:center;padding:80px 20px;color:var(--muted);font-size:14px}
  .spinner{width:32px;height:32px;border:3px solid #E5E7EB;border-top-color:var(--gold);border-radius:50%;animation:spin 0.7s linear infinite;margin:0 auto 14px}
  @keyframes spin{to{transform:rotate(360deg)}}
  .empty{text-align:center;padding:40px 20px;color:var(--muted);font-size:14px}
  .footer{text-align:center;padding:20px;font-size:11px;color:var(--muted)}
  .footer a{color:var(--gold);text-decoration:none;font-weight:600}
</style>
</head>
<body>
<div class="header">
  <div class="logo">A</div>
  <h1><span>Avatar Sales Academy</span>Tableau de progression</h1>
</div>
<div class="container">
  <div id="loading" class="loading"><div class="spinner"></div>Chargement des scores…</div>
  <div id="app" style="display:none">

    <div class="selector">
      <div class="avatar" id="avatarInitial">?</div>
      <select id="sel"></select>
    </div>

    <div class="score-hero">
      <div class="ring-container">
        <svg viewBox="0 0 120 120" width="110" height="110">
          <circle class="ring-bg" cx="60" cy="60" r="50"/>
          <circle class="ring-fill" id="ring" cx="60" cy="60" r="50" stroke-dasharray="314.16" stroke-dashoffset="314.16"/>
        </svg>
        <div class="ring-label">
          <div class="pct" id="pctVal">—</div>
          <div class="tag">Score moyen</div>
        </div>
      </div>
      <div class="score-details">
        <div class="level-badge green" id="badge">—</div>
        <div class="meta" id="metaInfo"></div>
      </div>
    </div>

    <div class="stats">
      <div class="stat">
        <div class="num" id="sModules">—</div>
        <div class="lbl">Modules</div>
      </div>
      <div class="stat">
        <div class="num" id="sBest">—</div>
        <div class="lbl">Meilleur</div>
      </div>
      <div class="stat">
        <div class="num" id="sDelta">—</div>
        <div class="lbl">Progression</div>
        <div class="delta flat" id="sDeltaArrow"></div>
      </div>
    </div>

    <div class="chart-card">
      <div class="title">📈 Évolution des scores</div>
      <canvas id="chart"></canvas>
    </div>

    <div class="activity-card">
      <div class="title">🕹️ Dernières activités</div>
      <div id="actList"></div>
    </div>
  </div>
</div>
<div class="footer">Propulsé par <a href="https://avatar-sales-academy.com" target="_blank">Avatar Sales Academy</a></div>

<script>
const URL = "https://script.google.com/macros/s/AKfycbxtJfHhsOU_Gw09zNfj6AnkAgk9hMhQZI5x6Jz7n41DnYUbLYptqZA0ZaXwarDz8TTV/exec";
let scores=[], chart=null;

async function init(){
  try{
    const r=await fetch(URL+"?action=dashboard");
    const j=await r.json();
    scores=j.scorm||[];
  }catch(e){
    scores=[
      {timestamp:"2026-08-28T13:03:44Z",module:"QUIZ MATRICE EISENHOWER",learner:"Régis",score:65,max:80,pct:0.813},
      {timestamp:"2026-08-29T09:15:00Z",module:"QUIZ MATRICE EISENHOWER",learner:"Amélie Dupont",score:55,max:80,pct:0.688},
      {timestamp:"2026-08-29T09:30:00Z",module:"OBJECTION NINJA",learner:"Amélie Dupont",score:72,max:100,pct:0.72},
      {timestamp:"2026-08-29T10:00:00Z",module:"QUIZ MATRICE EISENHOWER",learner:"Lucas Martin",score:40,max:80,pct:0.50},
      {timestamp:"2026-08-30T14:00:00Z",module:"QUIZ MATRICE EISENHOWER",learner:"Lucas Martin",score:70,max:80,pct:0.875},
      {timestamp:"2026-08-30T14:15:00Z",module:"OBJECTION NINJA",learner:"Lucas Martin",score:85,max:100,pct:0.85},
      {timestamp:"2026-08-31T09:00:00Z",module:"DIGITALISER L'ARTISAN",learner:"Lucas Martin",score:78,max:100,pct:0.78},
    ];
  }
  buildUI();
}

function buildUI(){
  const names=[...new Set(scores.map(r=>r.learner))].sort();
  if(!names.length){document.getElementById("loading").innerHTML='<div class="empty">Aucun score enregistré</div>';return}
  const sel=document.getElementById("sel");
  sel.innerHTML=names.map(n=>'<option value="'+n+'">'+n+'</option>').join("");
  const pre=new URLSearchParams(location.search).get("apprenant");
  if(pre&&names.includes(pre))sel.value=pre;
  sel.addEventListener("change",()=>render(sel.value));
  document.getElementById("loading").style.display="none";
  document.getElementById("app").style.display="block";
  render(sel.value);
}

function render(name){
  // Avatar
  const initials=name.split(" ").map(w=>w[0]).join("").slice(0,2).toUpperCase();
  document.getElementById("avatarInitial").textContent=initials;

  const rows=scores.filter(r=>r.learner===name&&r.pct>0).sort((a,b)=>new Date(a.timestamp)-new Date(b.timestamp));
  const avg=rows.length?rows.reduce((s,r)=>s+r.pct,0)/rows.length:0;
  const pct=Math.round(avg*100);

  // Ring animation
  const ring=document.getElementById("ring");
  const circ=314.16;
  ring.style.strokeDashoffset=circ-(circ*avg);
  ring.style.stroke=avg>=0.8?"#10B981":avg>=0.6?"#D4A843":avg>=0.4?"#F59E0B":"#EF4444";
  document.getElementById("pctVal").textContent=pct+"%";

  // Badge
  const badge=document.getElementById("badge");
  badge.className="level-badge";
  if(avg>=0.8){badge.textContent="🟢 Maîtrise";badge.classList.add("green")}
  else if(avg>=0.6){badge.textContent="🟡 Acquis";badge.classList.add("yellow")}
  else if(avg>=0.4){badge.textContent="🟠 En cours";badge.classList.add("orange")}
  else{badge.textContent="🔴 À renforcer";badge.classList.add("red")}

  // Meta
  const uniq=[...new Set(rows.map(r=>r.module))];
  document.getElementById("metaInfo").innerHTML=
    "<strong>"+rows.length+"</strong> session"+(rows.length>1?"s":"")+" sur <strong>"+uniq.length+"</strong> module"+(uniq.length>1?"s":"")+(rows.length?"<br>Dernier : "+new Date(rows[rows.length-1].timestamp).toLocaleDateString("fr-FR",{day:"2-digit",month:"long"}):"");

  // Stats
  document.getElementById("sModules").textContent=uniq.length;
  const best=rows.length?Math.round(Math.max(...rows.map(r=>r.pct))*100):0;
  document.getElementById("sBest").textContent=best+"%";

  let delta=0;
  if(rows.length>=2){
    const h=Math.ceil(rows.length/2);
    const f=rows.slice(0,h).reduce((s,r)=>s+r.pct,0)/h;
    const sc=rows.slice(h).reduce((s2,r)=>s2+r.pct,0)/(rows.length-h);
    delta=sc-f;
  }
  const dPct=Math.round(delta*100);
  document.getElementById("sDelta").textContent=(delta>=0?"+":"")+dPct+"%";
  const arrow=document.getElementById("sDeltaArrow");
  arrow.textContent=delta>0?"▲ hausse":delta<0?"▼ baisse":"— stable";
  arrow.className="delta "+(delta>0?"up":delta<0?"down":"flat");

  // Chart
  renderChart(rows);

  // Activity
  const recent=[...rows].reverse().slice(0,5);
  const list=document.getElementById("actList");
  if(!recent.length){list.innerHTML='<div class="empty">Aucune activité</div>';return}
  list.innerHTML=recent.map(r=>{
    const p=Math.round(r.pct*100);
    const cls=p>=75?"high":p>=50?"mid":"low";
    const d=new Date(r.timestamp);
    const ds=d.toLocaleDateString("fr-FR",{day:"2-digit",month:"short"})+" · "+d.toLocaleTimeString("fr-FR",{hour:"2-digit",minute:"2-digit"});
    return '<div class="act-row"><div class="act-icon">🕹️</div><div class="act-info"><div class="name">'+r.module+'</div><div class="date">'+ds+' · '+r.score+'/'+r.max+'</div></div><div class="act-score '+cls+'">'+p+'%</div></div>';
  }).join("");
}

function renderChart(rows){
  const ctx=document.getElementById("chart");
  if(chart)chart.destroy();

  const labels=rows.map(r=>{
    const d=new Date(r.timestamp);
    return d.toLocaleDateString("fr-FR",{day:"2-digit",month:"short"});
  });
  const data=rows.map(r=>Math.round(r.pct*100));

  const gradient=ctx.getContext("2d").createLinearGradient(0,0,0,180);
  gradient.addColorStop(0,"rgba(212,168,67,0.3)");
  gradient.addColorStop(1,"rgba(212,168,67,0.02)");

  chart=new Chart(ctx,{
    type:"line",
    data:{
      labels:labels,
      datasets:[{
        label:"Score %",
        data:data,
        borderColor:"#D4A843",
        backgroundColor:gradient,
        borderWidth:3,
        pointBackgroundColor:"#0D1B35",
        pointBorderColor:"#D4A843",
        pointBorderWidth:2,
        pointRadius:5,
        pointHoverRadius:7,
        fill:true,
        tension:0.35
      }]
    },
    options:{
      responsive:true,
      maintainAspectRatio:false,
      plugins:{
        legend:{display:false},
        tooltip:{
          backgroundColor:"#0D1B35",
          titleFont:{family:"Inter",weight:"600"},
          bodyFont:{family:"Inter"},
          cornerRadius:10,
          padding:12,
          callbacks:{
            label:function(ctx){return " "+ctx.parsed.y+"% — "+rows[ctx.dataIndex].score+"/"+rows[ctx.dataIndex].max}
          }
        }
      },
      scales:{
        y:{
          min:0,max:100,
          ticks:{
            callback:v=>v+"%",
            font:{family:"Inter",size:11,weight:"500"},
            color:"#8B92A5"
          },
          grid:{color:"#F0F2F5"}
        },
        x:{
          ticks:{font:{family:"Inter",size:11},color:"#8B92A5"},
          grid:{display:false}
        }
      },
      animation:{duration:800,easing:"easeOutQuart"}
    }
  });
}

init();
</script>
</body>
</html>
